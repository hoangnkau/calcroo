# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The password Kayla will type on the /abn-expense-tracker page.
ABN_TRACKER_PASSWORD=choose-a-strong-password

# A separate random secret used only to sign the login-session cookie.
# Generate one with: openssl rand -hex 32
ABN_TRACKER_SECRET=paste-a-long-random-string-here
